{
  "name": "dsh-provider-gmi",
  "version": "0.1.1",
  "description": "GMI Cloud as a model provider for DeepSeek Harness (DSH): DeepSeek V4/V4.1, Kimi K2.7 Code, GLM-5.3, Qwen3.8 Max and MiniMax M3 on GMI's Inference Engine, with tool calling and per-model reasoning switches verified, plus a doctor CLI that re-checks them with your key.",
  "type": "module",
  "license": "MIT",
  "main": "./lib/models.mjs",
  "exports": {
    ".": "./lib/models.mjs",
    "./doctor": "./lib/doctor.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-provider-gmi": "bin/dsh-provider-gmi.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/Junfei-Z/dsh-provider-gmi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Junfei-Z/dsh-provider-gmi.git"
  },
  "bugs": {
    "url": "https://github.com/Junfei-Z/dsh-provider-gmi/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "gmi-cloud",
    "gmi",
    "provider",
    "openai-compatible",
    "deepseek",
    "llm"
  ],
  "engines": {
    "node": ">=22.18",
    "dsh": ">=0.2.0-0"
  },
  "scripts": {
    "gen": "node scripts/gen-patch.mjs",
    "test": "node scripts/gen-patch.mjs --check && node --test \"test/*.test.mjs\"",
    "doctor": "node bin/dsh-provider-gmi.mjs doctor"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
